# Copy to .env.local and fill in from the Supabase project settings
# (Project Settings → API). The game still runs without these keys;
# progress stays in the browser until you sign in.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Older projects expose the same value as the anon key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
