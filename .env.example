# Copy to .env.local for local cloud save, or set these in Vercel
# (Project → Settings → Environment Variables) before the first production build.
# The game still runs without them: progress stays in the browser until you sign in.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Newer Supabase dashboards label the same value as the publishable key.
# The app accepts either name; you only need one.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
